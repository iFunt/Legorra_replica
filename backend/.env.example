PORT=3001
FRONTEND_URL=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=mike

GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENROUTER_API_KEY=your-openrouter-key
RESEND_API_KEY=your-resend-key

# --- GDPR claims platform (backend/src/lib/claims/, backend/src/routes/claims.ts) ---

# Optional extra LLM providers for the claims pipeline's cheaper drafting/
# extraction steps (see backend/src/lib/llm/models.ts). The judge/auto-test
# step always uses Claude Opus (ANTHROPIC_API_KEY above) regardless of these.
OPENAI_API_KEY=your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
KIMI_API_KEY=your-kimi-moonshot-key
KIMI_BASE_URL=https://api.moonshot.ai/v1

# Companies House lookup (backend/src/lib/claims/companyResearch.ts).
# Get a free API key at https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=your-companies-house-api-key

# Web search provider used to find a company's privacy policy and ICO
# enforcement history. Pick one: "bing" | "brave" | "google".
# Without this configured, research falls back to best-effort/LLM-knowledge
# only (see companyResearch.ts degradedNotes).
SEARCH_API_PROVIDER=brave
SEARCH_API_KEY=your-search-provider-key
# Only required when SEARCH_API_PROVIDER=google (Custom Search Engine ID).
SEARCH_API_CX=your-google-cse-id
